# Comma-separated list of origins the frontend is allowed to call the API from.
# Include every port your Vite dev server might land on (it auto-increments
# from 5173 if that port is already taken).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Package storage configuration (optional, defaults to media/packages/)
# PACKAGES_ROOT=

